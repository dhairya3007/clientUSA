<?xml version="1.0" encoding="utf-8"?>
<!--
  WINDOWS IIS CONFIGURATION FOR EMAIL SERVICE
  Place this in your website root or api/ folder
-->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.5" />
    <httpRuntime targetFramework="4.5" />
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    
    <!-- Register ASP.NET SimpleHandlerFactory for .ashx files -->
    <handlers>
      <remove name="SimpleHandlerFactory-Integrated-4.0" />
      <remove name="SimpleHandlerFactory-Integrated" />
      <add name="SimpleHandlerFactory-Integrated-4.0" path="*.ashx" verb="*" type="System.Web.UI.SimpleHandlerFactory" resourceType="Unspecified" requireAccess="Script" preCondition="integratedMode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Do NOT rewrite .ashx requests -->
        <rule name="IgnoreASHX" stopProcessing="true">
          <match url=".*\.ashx" />
          <action type="None" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
